generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgres"
  url      = env("DATABASE_URL")
}

enum ApplicationStatus {
  SUBMITTED
}

model User {
  id          String       @id @default(cuid())
  nuit        String?      @unique
  fullName    String
  birthDate   DateTime
  gender      String
  nationality String
  idNumber    String       @unique
  phone       String
  email       String?
  province    String
  district    String
  address     String?
  school      String?
  academicLevel String?
  trainingArea  String?
  academicGroup String?
  educationCourse String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  application Application?
  sessions    Session[]
}

model Course {
  id           String        @id
  name         String
  shortName    String
  active       Boolean       @default(true)
  applications Application[]
}

model ResourceCenter {
  id           String        @id
  name         String
  location     String
  active       Boolean       @default(true)
  applications Application[]
}

model Application {
  id               String            @id @default(cuid())
  userId           String            @unique
  courseId         String
  resourceCenterId String
  status           ApplicationStatus @default(SUBMITTED)
  submittedAt      DateTime          @default(now())
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  course           Course            @relation(fields: [courseId], references: [id])
  resourceCenter   ResourceCenter    @relation(fields: [resourceCenterId], references: [id])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Administrator {
  id           String         @id @default(cuid())
  username     String         @unique
  name         String
  passwordHash String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  sessions     AdminSession[]
}

model AdminSession {
  id              String        @id @default(cuid())
  tokenHash       String        @unique
  administratorId String
  expiresAt       DateTime
  createdAt       DateTime      @default(now())
  administrator   Administrator @relation(fields: [administratorId], references: [id], onDelete: Cascade)

  @@index([administratorId])
  @@index([expiresAt])
}

model SystemSettings {
  id                String    @id
  registrationStart DateTime?
  registrationEnd   DateTime?
  updatedAt         DateTime  @updatedAt
}
